[Unit]
Description=Saphir - bot Discord
Documentation=https://github.com/u9747585327-crypto/saphir-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=saphir-bot
Group=saphir-bot
WorkingDirectory=/opt/saphir-bot
EnvironmentFile=/opt/saphir-bot/.env
# Le bot affiche des emojis dans ses logs : sans ca, un serveur en locale C
# ferait planter le moindre print().
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/saphir-bot/.venv/bin/python -u main.py

# redemarrage automatique : coupure reseau, kill OOM, crash non rattrape...
Restart=always
RestartSec=10

# les print() du bot partent dans journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=saphir

# durcissement : le bot n'a besoin d'ecrire que dans son dossier data/
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/saphir-bot/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
